{
  "name": "atlassian-admin",
  "displayName": "Atlassian MCP for Admins",
  "version": "1.0.0",
  "description": "Acesso administrativo a Jira Cloud, Jira Service Management e Jira Forms: servidor MCP com ferramentas genericas de leitura, escrita e exclusao, e uma skill por area da API com endpoints, payloads e fluxo seguro.",
  "author": {
    "name": "Heryclles Henrique do Nascimento"
  },
  "keywords": [
    "atlassian",
    "jira",
    "jsm",
    "forms",
    "admin",
    "mcp"
  ],
  "userConfig": {
    "jira_url": {
      "type": "string",
      "title": "URL do site Atlassian",
      "description": "Sem barra no final. Ex.: https://empresa.atlassian.net",
      "required": false,
      "default": ""
    },
    "jira_email": {
      "type": "string",
      "title": "E-mail da conta administradora",
      "description": "Conta Atlassian dona do API token",
      "required": false,
      "default": ""
    },
    "jira_token": {
      "type": "string",
      "title": "API token",
      "description": "Gerado em https://id.atlassian.com/manage-profile/security/api-tokens",
      "sensitive": true,
      "required": false,
      "default": ""
    }
  },
  "mcpServers": {
    "api": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--quiet",
        "python",
        "-m",
        "atlassian_mcp_for_admins"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "JIRA_URL": "${user_config.jira_url}",
        "JIRA_EMAIL": "${user_config.jira_email}",
        "JIRA_TOKEN": "${user_config.jira_token}"
      }
    }
  },
  "skills": "./skills/"
}
