# Copie para .env e preencha. O .env esta no .gitignore.

# URL base do site Jira Cloud, sem barra no final. Ex.: https://minhaempresa.atlassian.net
JIRA_URL=

# E-mail da conta Atlassian usada para gerar o token
JIRA_EMAIL=

# API token gerado em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=
